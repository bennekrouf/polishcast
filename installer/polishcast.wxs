<!--
  PolishCast — Windows Installer package (.msi), for IT departments.
  Build (WiX 5):
    wix build installer\polishcast.wxs -ext WixToolset.Util.wixext -arch x64 ^
      -d Version=X.Y.Z -o dist\polishcast.msi

  One package, both audiences (Scope="perUserOrMachine"):
    * double-clicked by someone: installs for them alone, in
      %LOCALAPPDATA%\Programs\PolishCast, with no admin prompt;
    * deployed by IT (Intune, Group Policy, SCCM): for every user, in
      C:\Program Files\PolishCast:
        msiexec /i polishcast.msi ALLUSERS=1 /qn

  Never change the UpgradeCode: it is how Windows and deployment tools know a
  new version replaces the old one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef Version ?>
    <?define Version = "0.1.0" ?>
  <?endif ?>

  <Package Name="PolishCast"
           Manufacturer="Mayorana"
           Version="$(var.Version)"
           UpgradeCode="389EE550-A0E1-4AC8-807A-9116205850A4"
           Scope="perUserOrMachine"
           Compressed="yes">

    <!-- Same version again reinstalls; older is refused, newer replaces. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of PolishCast is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows.Graphics.Capture with its capture settings needs build 19041. -->
    <Launch Condition="Installed OR WindowsBuild &gt;= 19041"
            Message="PolishCast needs Windows 10 version 2004 or later." />

    <Icon Id="PolishCastIcon" SourceFile="..\crates\app\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="PolishCastIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://mayorana.ch/en/apps/polishcast" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bennekrouf/polishcast/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- ── Close the running app ─────────────────────────────────────────────
         Asked to close first, then ended if it hasn't, so the files are never
         in use and no "close these applications" prompt is left stuck. -->
    <util:CloseApplication Id="ClosePolishCast"
                           Target="polishcast.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           TerminateProcess="1"
                           Timeout="5" />

    <!-- ── Replace an install made with polishcast-setup.exe ─────────────────
         The .exe installer (Inno Setup) uses the same folder. Its uninstaller
         runs silently first, so the two never sit side by side. -->
    <Property Id="INNO_UNINST_USER">
      <RegistrySearch Root="HKCU" Bitness="always64" Type="raw" Name="UninstallString"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{B8AE3061-4BF6-4AF3-BCAA-D8BC0CB179B2}_is1" />
    </Property>
    <Property Id="INNO_UNINST_MACHINE">
      <RegistrySearch Root="HKLM" Bitness="always64" Type="raw" Name="UninstallString"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{B8AE3061-4BF6-4AF3-BCAA-D8BC0CB179B2}_is1" />
    </Property>

    <SetProperty Id="RemoveInnoUser" Sequence="execute" Before="RemoveInnoUser"
                 Value="[INNO_UNINST_USER] /VERYSILENT /SUPPRESSMSGBOXES /NORESTART"
                 Condition="INNO_UNINST_USER AND NOT REMOVE" />
    <CustomAction Id="RemoveInnoUser" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- A machine-wide one needs the installer's own rights to remove. -->
    <SetProperty Id="RemoveInnoMachine" Sequence="execute" Before="RemoveInnoMachine"
                 Value="[INNO_UNINST_MACHINE] /VERYSILENT /SUPPRESSMSGBOXES /NORESTART"
                 Condition="INNO_UNINST_MACHINE AND NOT REMOVE AND Privileged" />
    <CustomAction Id="RemoveInnoMachine" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveInnoUser" After="InstallInitialize"
              Condition="INNO_UNINST_USER AND NOT REMOVE" />
      <Custom Action="RemoveInnoMachine" After="RemoveInnoUser"
              Condition="INNO_UNINST_MACHINE AND NOT REMOVE AND Privileged" />
    </InstallExecuteSequence>

    <!-- ── Files ───────────────────────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PolishCast">
        <Component Id="App">
          <File Id="PolishCastExe" Source="..\target\release\polishcast.exe" KeyPath="yes" />
        </Component>
        <Component Id="WebView2Loader">
          <File Source="..\target\release\WebView2Loader.dll" KeyPath="yes" />
        </Component>
        <!-- ffmpeg, shipped so nothing is downloaded at first use, with its GPL notice. -->
        <Component Id="Ffmpeg">
          <File Source="..\target\release\ffmpeg.exe" KeyPath="yes" />
        </Component>
        <Component Id="FfmpegLicence">
          <File Source="..\target\release\ffmpeg-LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="FfmpegSource">
          <File Source="..\target\release\ffmpeg-SOURCE.txt" KeyPath="yes" />
        </Component>
        <Component Id="AppIcon">
          <File Id="IconFile" Source="..\crates\app\assets\icon.ico" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start menu only: IT decides about desktop shortcuts. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="PolishCastShortcut"
                  Name="PolishCast"
                  Description="Screen recordings, polished"
                  Target="[INSTALLFOLDER]polishcast.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PolishCastIcon" />
        <RegistryValue Root="HKMU" Key="Software\Mayorana\PolishCast"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="App" />
      <ComponentRef Id="WebView2Loader" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="Ffmpeg" />
      <ComponentRef Id="FfmpegLicence" />
      <ComponentRef Id="FfmpegSource" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
